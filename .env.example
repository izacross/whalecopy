# paper = simulate only (default). live = real orders, and also needs LIVE_CONFIRM below.
MODE=paper
LIVE_CONFIRM=
# prod = real Kalshi. demo = demo-api.kalshi.co (fake money, separate account and keys).
KALSHI_ENV=prod

# Only needed for `whalecopy check` and live mode. Create at kalshi.com > Settings > API.
KALSHI_API_KEY_ID=
# Either a path to the .key/.pem file...
KALSHI_PRIVATE_KEY_PATH=
# ...or the PEM contents (use \n for line breaks if your host needs a single line).
KALSHI_PRIVATE_KEY_PEM=

# Where the SQLite database lives. On Fly.io/Railway point this at the mounted volume.
DATA_DIR=./data

# Optional Slack or Discord incoming webhook for trade alerts and daily summaries.
NOTIFY_WEBHOOK_URL=
