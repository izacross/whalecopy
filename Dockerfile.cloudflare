# Image for Cloudflare Containers (see cloudflare/ and README "Deploy to Cloudflare").
# Same bot as ./Dockerfile, plus Litestream: Cloudflare container disks are wiped on every
# restart, so the SQLite database is streamed to an R2 bucket and restored on boot.
# Fly.io keeps using ./Dockerfile with its /data volume.
FROM litestream/litestream:0.3.13 AS litestream

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DATA_DIR=/data
WORKDIR /app

COPY pyproject.toml ./
COPY whalecopy ./whalecopy
RUN pip install .

# Copies config.example.yaml and, if you created one, config.yaml (env vars override both).
COPY config* ./

COPY --from=litestream /usr/local/bin/litestream /usr/local/bin/litestream
COPY cloudflare/litestream.yml /etc/litestream.yml
COPY cloudflare/entrypoint.sh /usr/local/bin/whalecopy-entrypoint
RUN chmod +x /usr/local/bin/whalecopy-entrypoint && mkdir -p /data

CMD ["whalecopy-entrypoint"]
